generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  MANAGER
  RECEPTIONIST
  PRACTITIONER
  ACCOUNTANT
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum MeetingType {
  CHILD
  PARENT_A
  PARENT_B
  BOTH_PARENTS
}

enum BillingArrangement {
  REGULAR
  SHARED_SINGLE_INVOICE
  SHARED_SEPARATE_INVOICES
}

enum InvoiceKind {
  SINGLE
  PARENT_A_SHARE
  PARENT_B_SHARE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  displayName  String
  passwordHash String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  memberships  ClinicMembership[]
  auditEvents  AuditLog[]
}

model Clinic {
  id            String             @id @default(cuid())
  name          String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  memberships   ClinicMembership[]
  clients       Client[]
  meetings      Meeting[]
  invoices      Invoice[]
  auditEvents   AuditLog[]

  @@index([name])
}

model ClinicMembership {
  id        String         @id @default(cuid())
  userId    String
  clinicId  String
  role      MembershipRole
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic    Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([userId, clinicId])
  @@index([clinicId])
}

model Client {
  id             String          @id @default(cuid())
  clinicId       String
  externalRef    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  clinic         Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  childMeetings  Meeting[]       @relation("MeetingChild")
  parentAMeetings Meeting[]      @relation("MeetingParentA")
  parentBMeetings Meeting[]      @relation("MeetingParentB")
  invoices       Invoice[]

  @@unique([clinicId, externalRef])
  @@index([clinicId])
}

model Meeting {
  id                 String            @id @default(cuid())
  clinicId           String
  clientId           String
  parentAId          String?
  parentBId          String?
  startsAt           DateTime
  type               MeetingType
  status             AppointmentStatus @default(SCHEDULED)
  tariff             Decimal           @db.Decimal(12, 2)
  billingArrangement BillingArrangement
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  clinic             Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  client             Client            @relation("MeetingChild", fields: [clientId], references: [id], onDelete: Restrict)
  parentA            Client?           @relation("MeetingParentA", fields: [parentAId], references: [id], onDelete: Restrict)
  parentB            Client?           @relation("MeetingParentB", fields: [parentBId], references: [id], onDelete: Restrict)
  invoices           Invoice[]

  @@index([clinicId, startsAt])
  @@index([clinicId, clientId])
  @@index([clinicId, type])
}

model Invoice {
  id          String        @id @default(cuid())
  clinicId    String
  meetingId   String
  issuedToId  String?
  kind        InvoiceKind
  amount      Decimal       @db.Decimal(12, 2)
  status      InvoiceStatus @default(DRAFT)
  issuedAt    DateTime?
  createdAt   DateTime      @default(now())
  clinic      Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  meeting     Meeting       @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  issuedTo    Client?       @relation(fields: [issuedToId], references: [id], onDelete: Restrict)

  @@unique([meetingId, kind])
  @@index([clinicId, status])
}

model AuditLog {
  id         String   @id @default(cuid())
  clinicId   String
  userId     String
  action     String
  entityType String
  entityId   String
  createdAt  DateTime @default(now())
  clinic     Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([clinicId, createdAt])
  @@index([userId, createdAt])
}
